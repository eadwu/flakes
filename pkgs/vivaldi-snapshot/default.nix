    version = "7.2.3597.3";

    src = fetchurl {
      url = "https://downloads.vivaldi.com/snapshot/vivaldi-snapshot_${version}-1_amd64.deb";
      sha256 = "1lj8zxr9s8w2ljwz9m0jrgfb588pw7vbyxy19k5g27zi9qhhnbj3";
    };
  }
)
